<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_bank_form_base_bank_from_iban" model="ir.ui.view">
        <field name="name">res.partner.bank.form.base.bank.from.iban</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form" />
        <field name="arch" type="xml">
            <field name="bank_bic" position="after">
                <field name="bank_code" />
            </field>
        </field>
    </record>

    <record id="view_partner_bank_tree_base_bank_from_iban" model="ir.ui.view">
        <field name="name">res.partner.bank.list.base.bank.from.iban</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_tree" />
        <field name="arch" type="xml">
            <field name="bank_bic" position="after">
                <field name="bank_code" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
