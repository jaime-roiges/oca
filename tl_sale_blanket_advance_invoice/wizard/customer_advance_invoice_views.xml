<odoo>
  <record id="action_tl_customer_contract_advance" model="ir.actions.act_window">
    <field name="name">Factura de anticipo del contrato</field>
    <field name="res_model">tl.sale.blanket.advance.invoice.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="context">{'default_blanket_order_id': active_id}</field>
  </record>
  <record id="view_tl_customer_contract_advance_wizard" model="ir.ui.view">
    <field name="name">tl.sale.blanket.advance.invoice.wizard.form</field>
    <field name="model">tl.sale.blanket.advance.invoice.wizard</field>
    <field name="arch" type="xml">
      <form string="Factura de anticipo de cliente">
        <group>
          <field name="blanket_order_id"/>
          <field name="company_id" invisible="1"/>
          <field name="currency_id" invisible="1"/>
          <field name="amount_base"/>
          <field name="tax_ids" widget="many2many_tags"/>
          <field name="invoice_date"/>
          <field name="description"/>
        </group>
        <footer>
          <button name="action_create_advance_invoice" type="object" string="Generar factura de anticipo" class="btn-primary"/>
          <button special="cancel" string="Cancelar" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="view_tl_sale_blanket_customer_advance_button" model="ir.ui.view">
    <field name="name">sale.blanket.order.customer.advance.button</field>
    <field name="model">sale.blanket.order</field>
    <field name="inherit_id" ref="sale_blanket_order.view_blanket_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="%(tl_sale_blanket_advance_invoice.action_tl_customer_contract_advance)d"
                type="action" string="Factura de anticipo" class="btn-secondary"
                invisible="state not in ['open','done']" groups="account.group_account_user"/>
      </xpath>
    </field>
  </record>

</odoo>
