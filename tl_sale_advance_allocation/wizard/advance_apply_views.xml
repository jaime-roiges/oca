<odoo>
  <record id="view_tl_advance_apply_wizard" model="ir.ui.view">
    <field name="name">tl.sale.advance.apply.wizard.form</field>
    <field name="model">tl.sale.advance.apply.wizard</field>
    <field name="arch" type="xml"><form string="Apply invoiced advance">
      <group><field name="invoice_id" readonly="1"/><field name="advance_id"/><field name="invoice_line_id"/>
        <field name="amount_base"/><field name="currency_id" invisible="1"/></group>
      <footer><button name="action_apply" type="object" string="Apply advance" class="btn-primary"/><button special="cancel" string="Cancel"/></footer>
    </form></field>
  </record>
</odoo>
