<odoo>
  <record id="account_move_form_supply" model="ir.ui.view">
    <field name="name">account.move.form.blanket.advances</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_tl_create_advance" type="object" string="Register advance"
          groups="account.group_account_user" invisible="move_type not in ('out_invoice', 'in_invoice')"/>
        <button name="action_tl_apply_advance" type="object" string="Apply contract advance"
          groups="account.group_account_user" invisible="move_type not in ('out_invoice', 'in_invoice') or state != 'draft'"/>
      </xpath>
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="tl_blanket_order_id" domain="[('company_id', '=', company_id)]"/>
      </xpath>
    </field>
  </record>
</odoo>
