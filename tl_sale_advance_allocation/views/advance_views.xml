<odoo>
  <record id="view_tl_advance_list" model="ir.ui.view">
    <field name="name">tl.sale.advance.list</field><field name="model">tl.sale.advance</field>
    <field name="arch" type="xml"><list string="Contract advances" create="0" delete="0">
      <field name="blanket_order_id"/><field name="kind"/><field name="partner_id"/><field name="invoice_id"/>
      <field name="invoice_state"/><field name="payment_state"/>
      <field name="amount_base"/><field name="amount_applied"/><field name="amount_remaining"/>
      <field name="currency_id" column_invisible="True"/>
    </list></field>
  </record>
  <record id="view_tl_advance_form" model="ir.ui.view">
    <field name="name">tl.sale.advance.form</field><field name="model">tl.sale.advance</field>
    <field name="arch" type="xml"><form string="Invoiced advance" create="0" delete="0">
      <header><button name="action_view_invoice" type="object" string="View invoice"/></header>
      <sheet><group><group><field name="blanket_order_id" readonly="1"/><field name="kind" readonly="1"/><field name="partner_id" readonly="1"/>
        <field name="invoice_id" readonly="1"/><field name="invoice_line_id" readonly="1"/></group>
        <group><field name="amount_base"/><field name="amount_applied"/><field name="amount_remaining"/><field name="currency_id" invisible="1"/>
          <field name="account_id"/><field name="tax_ids" widget="many2many_tags"/></group></group>
        <field name="allocation_ids" readonly="1"><list><field name="invoice_id"/><field name="amount_base"/></list></field>
      </sheet>
    </form></field>
  </record>
  <record id="action_tl_advances" model="ir.actions.act_window">
    <field name="name">Invoiced advances</field><field name="res_model">tl.sale.advance</field><field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_tl_advances" name="Invoiced advances" parent="sale.sale_order_menu" action="action_tl_advances" groups="account.group_account_user" sequence="20"/>
  <record id="view_tl_account_config" model="ir.ui.view">
    <field name="name">res.company.supply.advance.config.form</field><field name="model">res.company</field>
    <field name="arch" type="xml">
      <form string="Advance accounting configuration"><sheet>
        <group><field name="name" readonly="1"/><field name="tl_customer_advance_account_id"/>
          <field name="tl_supplier_advance_account_id"/><field name="tl_auto_allocate_sales"/></group>
      </sheet></form>
    </field>
  </record>
  <record id="action_tl_account_config" model="ir.actions.act_window">
    <field name="name">Advance accounting settings</field><field name="res_model">res.company</field>
    <field name="view_mode">list,form</field><field name="view_id" ref="view_tl_account_config"/>
  </record>
  <menuitem id="menu_tl_adv_config" name="Advance settings" parent="sale.menu_sale_config" action="action_tl_account_config" groups="account.group_account_manager" sequence="90"/>
</odoo>
