<odoo>
  <template id="dimpal_portal_home_entry" inherit_id="portal.portal_my_home" name="Dimpal OCA blanket contracts">
    <xpath expr="//div[contains(@class, 'o_portal_docs')]" position="inside">
      <div class="mt-3 border rounded p-3"><a href="/my/dimpal/contracts">Mis contratos de suministro</a></div>
    </xpath>
  </template>
  <template id="portal_contracts" name="My OCA Blanket Contracts">
    <t t-call="portal.portal_layout"><div class="container my-4">
      <h2>Mis contratos de suministro</h2>
      <table class="table table-hover"><thead><tr><th>Contrato</th><th>Inicio</th><th>Fin</th></tr></thead>
        <tbody><tr t-foreach="contracts" t-as="contract">
          <td><a t-att-href="'/my/dimpal/contracts/%s' % contract.id"><t t-out="contract.name"/></a></td>
          <td><t t-out="contract.blanket_validity_start_date or ''"/></td>
          <td><t t-out="contract.blanket_validity_end_date or ''"/></td>
        </tr></tbody></table>
      <div t-if="not contracts" class="alert alert-info">No hay contratos disponibles.</div>
    </div></t>
  </template>
  <template id="portal_contract_detail" name="OCA Blanket Contract Detail">
    <t t-call="portal.portal_layout"><div class="container my-4">
      <a href="/my/dimpal/contracts">Volver a contratos</a>
      <h2>Contrato <t t-out="contract.name"/></h2>
      <p class="text-muted">Contrato marco de suministro. Las cantidades pendientes dependen de las liberaciones OCA confirmadas.</p>
      <div class="table-responsive"><table class="table table-striped">
        <thead><tr><th>Producto</th><th>Contratadas</th><th>Entregadas</th><th>Pendiente de liberación</th><th></th></tr></thead>
        <tbody><tr t-foreach="contract_lines" t-as="line">
          <td><t t-out="line.product_id.display_name"/></td>
          <td><t t-out="line.product_uom_qty"/></td>
          <td><t t-out="line.qty_delivered"/></td>
          <td><t t-out="line.call_off_remaining_qty"/></td>
          <td>
            <form t-if="line.call_off_remaining_qty &gt; 0" method="POST" t-att-action="'/my/dimpal/contracts/%s/request' % contract.id" class="d-flex gap-1">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <input type="hidden" name="line_id" t-att-value="line.id"/>
              <input type="number" name="quantity" step="any" min="0.001" class="form-control form-control-sm" required="required" style="max-width: 115px"/>
              <button type="submit" class="btn btn-outline-primary btn-sm">Solicitar</button>
            </form>
          </td>
        </tr></tbody></table></div>
      <h4>Anticipos de cliente (bases imponibles)</h4>
      <dl class="row">
        <dt class="col-sm-5">Facturado</dt><dd class="col-sm-7"><t t-out="advance_base"/> <t t-out="contract.currency_id.name"/></dd>
        <dt class="col-sm-5">Cobrado</dt><dd class="col-sm-7"><t t-out="advance_paid_base"/> <t t-out="contract.currency_id.name"/></dd>
        <dt class="col-sm-5">Aplicado</dt><dd class="col-sm-7"><t t-out="advance_applied"/> <t t-out="contract.currency_id.name"/></dd>
        <dt class="col-sm-5">Pendiente de aplicar</dt><dd class="col-sm-7"><t t-out="advance_remaining"/> <t t-out="contract.currency_id.name"/></dd>
      </dl>
      <h4>Solicitudes</h4>
      <table class="table table-sm"><thead><tr><th>Producto</th><th>Cantidad</th><th>Estado</th></tr></thead>
        <tbody><tr t-foreach="release_requests" t-as="req"><td><t t-out="req.line_id.product_id.display_name"/></td>
          <td><t t-out="req.quantity"/></td><td><t t-out="req.state"/></td></tr></tbody></table>
    </div></t>
  </template>
</odoo>
