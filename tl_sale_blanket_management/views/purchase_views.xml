<odoo>
  <record id="purchase_order_supply_form" model="ir.ui.view">
    <field name="name">purchase.order.supply.contract.form</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="tl_blanket_order_id" domain="[('company_id','=', company_id)]"/>
      </xpath>
    </field>
  </record>
</odoo>
