<odoo>
  <record id="view_tl_blanket_stock_allocate" model="ir.ui.view">
    <field name="name">tl.sale.blanket.stock.allocate.wizard.form</field>
    <field name="model">tl.sale.blanket.stock.allocate.wizard</field>
    <field name="arch" type="xml">
      <form string="Reservar físicamente mercancía para un contrato">
        <group>
          <field name="blanket_line_id"/>
          <field name="source_location_id"/>
          <field name="qty"/>
          <field name="uom_id" readonly="1"/>
        </group>
        <footer>
          <button name="action_allocate" type="object" string="Crear traslado interno" class="btn-primary"/>
          <button special="cancel" string="Cancelar" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
