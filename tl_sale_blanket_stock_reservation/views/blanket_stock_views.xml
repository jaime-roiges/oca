<odoo>
  <record id="view_blanket_stock_form" model="ir.ui.view">
    <field name="name">sale.blanket.order.stock.form</field>
    <field name="model">sale.blanket.order</field>
    <field name="inherit_id" ref="sale_blanket_order.view_blanket_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='line_ids']//list/field[@name='remaining_uom_qty']" position="after">
        <field name="tl_dedicated_warehouse_id" optional="hide"/>
        <field name="tl_dedicated_location_id" readonly="1" optional="hide"/>
        <field name="tl_dedicated_available_qty" readonly="1" optional="hide"/>
      </xpath>
      <xpath expr="//field[@name='line_ids']" position="after">
        <div class="text-muted">
          Para reservar existencias, abra una línea del contrato, indique el almacén y utilice
          la acción de asignación. Los traslados requieren validación desde Almacén/PDA.
        </div>
      </xpath>
    </field>
  </record>
  <record id="view_blanket_line_dedicated_form" model="ir.ui.view">
    <field name="name">sale.blanket.order.line.dedicated.form</field>
    <field name="model">sale.blanket.order.line</field>
    <field name="inherit_id" ref="sale_blanket_order.sale_blanket_order_line_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <group string="Stock dedicado al cliente">
          <field name="tl_dedicated_warehouse_id"/>
          <field name="tl_dedicated_location_id" readonly="1"/>
          <field name="tl_dedicated_available_qty" readonly="1"/>
          <button name="action_tl_allocate_stock" type="object" string="Asignar stock" class="btn-secondary"
                  groups="stock.group_stock_user"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
