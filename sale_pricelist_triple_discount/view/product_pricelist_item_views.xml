<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="product_pricelist_view_form_discount">
        <field name="name">Add triple discounts to Pricelist Rule form view</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_markup']/.." position="after">
                <label
                    for="discount2"
                    string="Discount 2"
                    invisible="compute_price not in ('discount', 'markup')"
                />
                <div
                    class="o_row"
                    invisible="compute_price not in ('discount', 'markup')"
                >
                    <field name="discount2" class="oe_inline w-auto o_input_6ch" />
                    <span>%</span>
                </div>
                <label
                    for="discount3"
                    string="Discount 3"
                    invisible="compute_price not in ('discount', 'markup')"
                />
                <div
                    class="o_row"
                    invisible="compute_price not in ('discount', 'markup')"
                >
                    <field name="discount3" class="oe_inline w-auto o_input_6ch" />
                    <span>%</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
