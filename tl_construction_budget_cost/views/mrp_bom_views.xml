<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="mrp_bom_form_quote_budget_cost" model="ir.ui.view">
  <field name="name">mrp.bom.form.construction.budget.cost</field>
  <field name="model">mrp.bom</field>
  <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
  <field name="priority">1700</field>
  <field name="arch" type="xml">
   <xpath expr="//field[@name='bom_line_ids']" position="before">
    <field name="tl_budget_editable" invisible="1" groups="sales_team.group_sale_manager"/>
    <button name="action_tl_prepare_bom_costs" type="object" string="Preparar costes del presupuesto" class="btn-secondary" groups="sales_team.group_sale_manager" invisible="not tl_budget_editable"/>
   </xpath>
   <xpath expr="//field[@name='bom_line_ids']/list/field[@name='uom_id']" position="after">
    <field name="tl_budget_unit_cost" string="Coste unitario presupuestado" groups="sales_team.group_sale_manager" readonly="not parent.tl_budget_editable"/>
   </xpath>
  </field>
 </record>
</odoo>
