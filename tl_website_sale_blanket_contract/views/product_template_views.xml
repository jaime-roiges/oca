<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_product_template_contract_packaging" model="ir.ui.view">
    <field name="name">product.template.contract.website.packaging</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='sale']" position="inside">
        <group string="Contractual eCommerce packagings">
          <field name="tl_contract_whole_pack_only"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
