<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="view_res_bank_form">
        <field name="name">res.partner.bank.form.l10n.es.partner</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form" />
        <field name="arch" type="xml">
            <field name="bank_name" position="after">
                <field name="bank_long_name" />
            </field>
            <field name="bank_bic" position="after">
                <field name="bank_vat" />
                <field name="bank_website" widget="url" />
            </field>
        </field>
    </record>
</odoo>
