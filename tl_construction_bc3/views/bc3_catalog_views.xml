<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bc3_catalog_list" model="ir.ui.view">
        <field name="name">bc3.catalog.list</field>
        <field name="model">bc3.catalog</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="edition"/><field name="company_id"/></list>
        </field>
    </record>
    <record id="view_bc3_catalog_form" model="ir.ui.view">
        <field name="name">bc3.catalog.form</field>
        <field name="model">bc3.catalog</field>
        <field name="arch" type="xml">
            <form string="BC3 Source Catalog">
                <sheet>
                    <group><field name="name"/><field name="edition"/><field name="company_id"/><field name="description"/></group>
                    <notebook>
                        <page string="Products"><field name="product_ids" readonly="1"/></page>
                        <page string="Imports"><field name="import_ids" readonly="1"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_bc3_import_history_list" model="ir.ui.view">
        <field name="name">bc3.import.history.list</field>
        <field name="model">bc3.import.history</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="catalog_id"/>
                <field name="checksum_sha256"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="view_bc3_import_history_form" model="ir.ui.view">
        <field name="name">bc3.import.history.form</field>
        <field name="model">bc3.import.history</field>
        <field name="arch" type="xml">
            <form string="BC3 Original Import" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="file_data" filename="name"/>
                        <field name="checksum_sha256"/>
                        <field name="file_size"/>
                        <field name="company_id"/>
                        <field name="catalog_id"/>
                        <field name="sale_order_id"/>
                        <field name="user_id"/>
                        <field name="create_date"/>
                        <field name="info_type"/>
                        <field name="import_mode"/>
                        <field name="validation_mode"/>
                        <field name="price_scope"/>
                    </group>
                    <group><field name="summary"/><field name="warnings"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bc3_catalog" model="ir.actions.act_window">
        <field name="name">BC3 Source Catalogs</field>
        <field name="res_model">bc3.catalog</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bc3_import_history" model="ir.actions.act_window">
        <field name="name">BC3 Import History</field>
        <field name="res_model">bc3.import.history</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_bc3_catalog" name="BC3 Catalogs" parent="sale.sale_menu_root"
              action="action_bc3_catalog" sequence="46" groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_bc3_history" name="BC3 Import History" parent="sale.sale_menu_root"
              action="action_bc3_import_history" sequence="47" groups="sales_team.group_sale_salesman"/>
</odoo>
