<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bc3_import_wizard_view_form" model="ir.ui.view">
        <field name="name">bc3.import.wizard.form</field>
        <field name="model">bc3.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import BC3">
                <group>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="import_mode"/>
                    <field name="partner_id" invisible="import_mode == 'catalog'"/>
                    <field name="sale_order_id" invisible="import_mode == 'catalog'"/>
                </group>
                <group>
                    <field name="bc3_catalog_id"/>
                    <field name="catalog_edition"/>
                    <field name="validation_mode"/>
                    <field name="price_scope"/>
                    <field name="update_existing"/>
                    <field name="reimport_policy" invisible="import_mode == 'catalog'"/>
                    <field name="allow_unknown_units"/>
                    <field name="import_breakdown" invisible="import_mode == 'catalog'"/>
                    <field name="prefer_decomposition_price"/>
                    <field name="apply_coefficients" invisible="import_mode == 'catalog'"/>
                    <field name="create_certification" invisible="import_mode == 'catalog'"/>
                </group>
                <group>
                    <field name="preview_result" readonly="1" nolabel="1" placeholder="Preview using the button below"/>
                </group>
                <footer>
                    <button name="action_preview" type="object" string="Preview" class="btn-secondary"/>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bc3_import_wizard" model="ir.actions.act_window">
        <field name="name">Import BC3</field>
        <field name="res_model">bc3.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_bc3_import"
        name="Import BC3"
        parent="sale.sale_menu_root"
        action="action_bc3_import_wizard"
        groups="sales_team.group_sale_salesman"
        sequence="45"/>
</odoo>
