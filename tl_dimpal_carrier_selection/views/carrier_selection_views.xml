<odoo>
  <record id="view_dimpal_sale_order_carrier_button" model="ir.ui.view">
    <field name="name">sale.order.form.dimpal.carrier.compare</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_dimpal_compare_carriers" type="object" string="Compare transport" groups="sales_team.group_sale_salesman" invisible="state not in ('draft','sent')"/>
      </xpath>
    </field>
  </record>
  <record id="view_dimpal_carrier_config" model="ir.ui.view">
    <field name="name">res.company.dimpal.carrier.config</field><field name="model">res.company</field>
    <field name="arch" type="xml"><form string="Carrier selection settings">
      <sheet><group><field name="name" readonly="1"/><field name="dimpal_auto_web_cheapest"/>
        <field name="dimpal_auto_sale_cheapest"/></group></sheet>
    </form></field>
  </record>
  <record id="action_dimpal_carrier_config" model="ir.actions.act_window">
    <field name="name">Carrier comparison settings</field><field name="res_model">res.company</field>
    <field name="view_mode">list,form</field><field name="view_id" ref="view_dimpal_carrier_config"/>
  </record>
  <menuitem id="menu_dimpal_carrier_root" name="Dimpal transport" groups="base.group_system" sequence="95"/>
  <menuitem id="menu_dimpal_carrier_config" name="Carrier settings" parent="menu_dimpal_carrier_root" action="action_dimpal_carrier_config" groups="base.group_system" sequence="95"/>
</odoo>
