<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_invoice_document"
        inherit_id="account.report_invoice_document"
        priority="100"
    >
        <xpath expr="//t[@t-set='display_discount']" position="replace">
            <t
                t-set="display_discount"
                t-value="any(l.discount1 or l.discount2 or l.discount3 for l in lines_to_report)"
            />
        </xpath>

        <xpath expr="//t[@t-set='display_discount']" position="after">
            <t
                t-set="discount_class"
                t-value="'text-end %s' % ('d-none d-md-table-cell' if report_type == 'html' else '')"
            />
        </xpath>

        <xpath expr="//th[@name='th_discount']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//th[@name='th_discount']" position="after">
            <th
                name="th_discount1"
                t-if="display_discount"
                t-att-class="discount_class"
            >
                <span>Disc.1 %</span>
            </th>
            <th
                name="th_discount2"
                t-if="display_discount"
                t-att-class="discount_class"
            >
                <span>Disc.2 %</span>
            </th>
            <th
                name="th_discount3"
                t-if="display_discount"
                t-att-class="discount_class"
            >
                <span>Disc.3 %</span>
            </th>
        </xpath>

        <xpath expr="//td[@name='td_discount']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[@name='td_discount']" position="after">
            <td
                name="td_discount1"
                t-if="display_discount"
                t-att-class="discount_class"
            >
                <span class="text-nowrap" t-field="line.discount1" />
            </td>
            <td
                name="td_discount2"
                t-if="display_discount"
                t-att-class="discount_class"
            >
                <span class="text-nowrap" t-field="line.discount2" />
            </td>
            <td
                name="td_discount3"
                t-if="display_discount"
                t-att-class="discount_class"
            >
                <span class="text-nowrap" t-field="line.discount3" />
            </td>
        </xpath>

        <xpath
            expr="//t[@t-set='line_colspan' and contains(@t-value, 'line.tax_ids')]"
            position="attributes"
        >
            <attribute name="t-value">
                3 + (3 if display_discount else 0) + (1 if display_taxes and not line.tax_ids else 0)
            </attribute>
        </xpath>

        <xpath
            expr="//t[@t-set='line_colspan' and contains(@t-value, 'grouped_line') and contains(@t-value, 'display_discount')]"
            position="attributes"
        >
            <attribute name="t-value">
                3 + (3 if display_discount else 0) + (1 if display_taxes and not grouped_line.get('taxes') else 0)
            </attribute>
        </xpath>

        <xpath expr="//td[@name='td_discount_grouped']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[@name='td_discount_grouped']" position="after">
            <td
                name="td_discount1_grouped"
                t-if="display_discount and (hide_details or grouped_line['display_type'] == 'product')"
                t-att-class="discount_class"
            />
            <td
                name="td_discount2_grouped"
                t-if="display_discount and (hide_details or grouped_line['display_type'] == 'product')"
                t-att-class="discount_class"
            />
            <td
                name="td_discount3_grouped"
                t-if="display_discount and (hide_details or grouped_line['display_type'] == 'product')"
                t-att-class="discount_class"
            />
        </xpath>
    </template>
</odoo>
