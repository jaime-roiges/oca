<odoo>
  <record id="account_move_form_dimpal" model="ir.ui.view">
    <field name="name">account.move.form.dimpal.advance</field><field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_dimpal_create_advance" type="object" string="Register advance" groups="account.group_account_user" invisible="not dimpal_blanket_order_id"/>
        <button name="action_dimpal_apply_advance" type="object" string="Apply contract advance" groups="account.group_account_user" invisible="not dimpal_blanket_order_id or state != 'draft'"/>
      </xpath>
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="dimpal_blanket_order_id" domain="[('order_type', '=', 'blanket'), ('company_id', '=', company_id)]"/>
      </xpath>
    </field>
  </record>
</odoo>
