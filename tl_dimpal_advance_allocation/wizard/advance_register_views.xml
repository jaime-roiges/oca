<odoo>
  <record id="view_dimpal_advance_register_wizard_form" model="ir.ui.view">
    <field name="name">tl.dimpal.advance.register.wizard.form</field>
    <field name="model">tl.dimpal.advance.register.wizard</field>
    <field name="arch" type="xml">
      <form string="Register fiscal advance invoice">
        <group><field name="invoice_id" readonly="1"/><field name="invoice_line_id"/></group>
        <footer><button name="action_register" type="object" string="Register advance" class="btn-primary"/>
                <button string="Cancel" special="cancel"/></footer>
      </form>
    </field>
  </record>
</odoo>
