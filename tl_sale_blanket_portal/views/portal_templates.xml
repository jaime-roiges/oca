<odoo>
  <!-- Keep this view's XML ID during upgrades, but stop rendering its legacy
       link: Odoo 20 renders portal home cards from portal.entry records. -->
  <template id="tl_portal_home_entry" inherit_id="portal.portal_my_home" name="Customer blanket contracts (legacy entry)">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
      <t t-if="False"/>
    </xpath>
  </template>

  <template id="portal_contracts" name="My blanket contracts">
    <t t-call="portal.portal_layout">
      <div class="container my-4">
        <h2>Mis contratos de suministro</h2>
        <form action="/my/contracts" method="GET" class="row g-2 align-items-end mb-3">
          <div class="col-md-4">
            <label class="form-label" for="contract_status">Estado del contrato</label>
            <select class="form-select" id="contract_status" name="status">
              <t t-foreach="status_choices" t-as="choice">
                <option t-att-value="choice[0]" t-att-selected="status == choice[0]">
                  <t t-out="choice[1]"/>
                </option>
              </t>
            </select>
          </div>
          <div class="col-md-5">
            <label class="form-label" for="contract_product">Producto</label>
            <select class="form-select" id="contract_product" name="product_id">
              <option value="">Todos los productos</option>
              <t t-foreach="products" t-as="product">
                <option t-att-value="product.id" t-att-selected="product_id == product.id">
                  <t t-out="product.display_name"/>
                </option>
              </t>
            </select>
          </div>
          <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a href="/my/contracts" class="btn btn-outline-secondary">Limpiar</a>
          </div>
        </form>
        <p class="text-muted small">
          <span>Contratos encontrados:</span> <t t-out="total_contracts"/>
        </p>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead><tr>
              <th>Contrato</th><th>Estado</th><th>Productos</th><th>Inicio</th><th>Fin</th><th>Anticipo disponible (sin IVA)</th>
            </tr></thead>
            <tbody>
              <tr t-foreach="contracts" t-as="contract">
                <td><a t-att-href="'/my/contracts/%s' % contract.id"><t t-out="contract.name"/></a></td>
                <td><t t-out="contract_statuses.get(contract.id, contract.state)"/></td>
                <td><t t-out="contract_products.get(contract.id, '')"/></td>
                <td><t t-out="contract.validity_start_date or ''"/></td>
                <td><t t-out="contract.validity_date or ''"/></td>
                <td><t t-out="advance_available_by_contract.get(contract.id, 0.0)"/> <t t-out="contract.currency_id.symbol"/></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div t-if="not contracts" class="alert alert-info">No hay contratos con estos filtros.</div>
        <nav t-if="pages &gt; 1" aria-label="Paginación de contratos">
          <ul class="pagination justify-content-center">
            <li t-att-class="'page-item' + (' disabled' if page == 1 else '')">
              <a class="page-link" t-att-href="'/my/contracts?status=%s&amp;product_id=%s&amp;page=%s' % (status, product_id, max(1, page - 1))">Anterior</a>
            </li>
            <li class="page-item disabled"><span class="page-link"><t t-out="page"/> / <t t-out="pages"/></span></li>
            <li t-att-class="'page-item' + (' disabled' if page == pages else '')">
              <a class="page-link" t-att-href="'/my/contracts?status=%s&amp;product_id=%s&amp;page=%s' % (status, product_id, min(pages, page + 1))">Siguiente</a>
            </li>
          </ul>
        </nav>
      </div>
    </t>
  </template>

  <template id="portal_contract_detail" name="Blanket Contract Detail">
    <t t-call="portal.portal_layout">
      <div class="container my-4">
        <a href="/my/contracts">Volver a contratos</a>
        <h2>Contrato <t t-out="contract.name"/></h2>
        <p><strong>Estado:</strong> <t t-out="contract_status"/></p>
        <p class="text-muted">El consumo corresponde a pedidos confirmados. Los presupuestos pendientes se muestran por separado y reducen temporalmente la disponibilidad contractual.</p>
        <form t-att-action="'/my/contracts/%s' % contract.id" method="GET"
              class="row g-2 align-items-end mb-3">
          <div class="col-md-5">
            <label class="form-label" for="contract_line_product">Filtrar líneas por producto</label>
            <select class="form-select" id="contract_line_product" name="product_id">
              <option value="">Todos los productos</option>
              <t t-foreach="line_products" t-as="product">
                <option t-att-value="product.id" t-att-selected="selected_product_id == product.id">
                  <t t-out="product.display_name"/>
                </option>
              </t>
            </select>
          </div>
          <div class="col-md-3"><button type="submit" class="btn btn-outline-primary">Filtrar</button></div>
        </form>
        <div class="table-responsive">
          <table class="table table-striped align-middle">
            <thead><tr>
              <th>Producto</th>
              <th>Contratadas</th>
              <th>Consumidas (pedidos confirmados)</th>
              <th>% consumido</th>
              <th>Pendientes en presupuestos</th>
              <th>Entregadas</th>
              <th>Disponible</th>
              <th>Solicitar entrega</th>
            </tr></thead>
            <tbody>
              <tr t-foreach="contract_lines" t-as="line">
                <t t-set="usage" t-value="line_usage[line.id]"/>
                <td><t t-out="line.product_id.display_name"/></td>
                <td><t t-out="line.original_uom_qty"/> <t t-out="line.product_uom.name"/></td>
                <td><t t-out="usage['consumed']"/></td>
                <td style="min-width: 110px;">
                  <div><t t-out="usage['percentage_display']"/></div>
                  <div class="progress" style="height: 0.5rem;">
                    <div class="progress-bar" role="progressbar"
                         t-att-style="'width: %.1f%%' % usage['progress_width']"
                         t-att-aria-valuenow="usage['progress_width']"
                         aria-valuemin="0" aria-valuemax="100"/>
                  </div>
                </td>
                <td><t t-out="usage['draft']"/></td>
                <td><t t-out="line.delivered_uom_qty"/></td>
                <td><t t-out="line.remaining_uom_qty"/></td>
                <td>
                  <form t-if="can_request and line.remaining_uom_qty &gt; 0" method="POST"
                        t-att-action="'/my/contracts/%s/request' % contract.id"
                        class="d-flex gap-1">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="line_id" t-att-value="line.id"/>
                    <input type="number" name="quantity" step="any" min="0.001"
                           t-att-max="line.remaining_uom_qty"
                           class="form-control form-control-sm" required="required" style="min-width: 85px; max-width: 120px"/>
                    <button type="submit" class="btn btn-outline-primary btn-sm">Solicitar</button>
                  </form>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div t-if="not can_request" class="alert alert-secondary">Este contrato es de solo consulta y no admite nuevas solicitudes.</div>
        <h4>Anticipos de cliente (bases imponibles, sin IVA)</h4>
        <p class="text-muted small">El saldo disponible solo incluye facturas de anticipo contabilizadas y totalmente cobradas. Las aplicaciones en facturas borrador están reservadas, pero aún no son definitivas. El IVA se consulta en cada factura fiscal.</p>
        <dl class="row">
          <dt class="col-sm-6">Base de anticipos facturados</dt><dd class="col-sm-6"><t t-out="advance_info['invoiced']"/> <t t-out="contract.currency_id.name"/></dd>
          <dt class="col-sm-6">Base de anticipos totalmente cobrados</dt><dd class="col-sm-6"><t t-out="advance_info['fully_paid']"/> <t t-out="contract.currency_id.name"/></dd>
          <dt class="col-sm-6">Aplicado en facturas contabilizadas</dt><dd class="col-sm-6"><t t-out="advance_info['posted_applied']"/> <t t-out="contract.currency_id.name"/></dd>
          <dt class="col-sm-6">Reservado en facturas borrador</dt><dd class="col-sm-6"><t t-out="advance_info['draft_reserved']"/> <t t-out="contract.currency_id.name"/></dd>
          <dt class="col-sm-6">Pendiente de cobro completo</dt><dd class="col-sm-6"><t t-out="advance_info['awaiting_payment']"/> <t t-out="contract.currency_id.name"/></dd>
          <dt class="col-sm-6"><strong>Anticipo disponible para aplicar</strong></dt><dd class="col-sm-6"><strong><t t-out="advance_info['available']"/> <t t-out="contract.currency_id.name"/></strong></dd>
        </dl>
        <h5>Detalle de facturas de anticipo y aplicaciones</h5>
        <div class="table-responsive">
          <table class="table table-sm table-striped">
            <thead><tr>
              <th>Factura de anticipo</th><th>Fecha</th><th>Estado de cobro</th>
              <th>Base</th><th>Aplicado contabilizado</th><th>Reservado en borradores</th><th>Disponible</th>
            </tr></thead>
            <tbody>
              <t t-foreach="advance_info['rows']" t-as="adv">
                <tr>
                  <td><t t-out="adv['invoice_name']"/></td><td><t t-out="adv['invoice_date']"/></td>
                  <td><t t-out="adv['payment_state_label']"/></td>
                  <td><t t-out="adv['base']"/></td><td><t t-out="adv['posted_applied']"/></td>
                  <td><t t-out="adv['draft_reserved']"/></td><td><t t-out="adv['available']"/></td>
                </tr>
                <tr t-if="adv['allocations']">
                  <td colspan="7" class="ps-4">
                    <strong>Aplicaciones a facturas de entrega:</strong>
                    <ul class="mb-0">
                      <li t-foreach="adv['allocations']" t-as="allocated">
                        <t t-out="allocated['invoice_name']"/>
                        <span class="text-muted">(<t t-out="allocated['invoice_date']"/>, <t t-out="allocated['state_label']"/>)</span>:
                        <t t-out="allocated['amount']"/> <t t-out="contract.currency_id.name"/>
                      </li>
                    </ul>
                  </td>
                </tr>
              </t>
              <tr t-if="not advance_info['rows']"><td colspan="7">No hay anticipos contabilizados para este contrato.</td></tr>
            </tbody>
          </table>
        </div>
        <h4>Solicitudes</h4>
        <table class="table table-sm">
          <thead><tr><th>Producto</th><th>Cantidad</th><th>Estado</th></tr></thead>
          <tbody><tr t-foreach="release_requests" t-as="req">
            <td><t t-out="req.line_id.product_id.display_name"/></td>
            <td><t t-out="req.quantity"/></td><td><t t-out="req.state"/></td>
          </tr></tbody>
        </table>
      </div>
    </t>
  </template>
</odoo>
