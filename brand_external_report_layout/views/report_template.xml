<odoo>
    <!-- Odoo 20: the layout dispatch is in web.external_layout.  A brand can
         override that dispatch, without altering the company default. -->
    <template id="brand_external_layout" inherit_id="web.external_layout">
        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="replace">
            <t t-set="brand_id" t-value="0"/>
            <!-- Brand document layout preview: `brand` is the wizard. -->
            <t t-if="brand and brand.external_report_layout_id"
               t-call="{{brand.external_report_layout_id.sudo().key}}">
                <t t-set="brand_id" t-value="brand.id"/>
                <t t-set="company" t-value="brand"/>
                <t t-out="0"/>
            </t>
            <!-- Actual document with a brand-specific layout. -->
            <t t-elif="o and 'brand_id' in o._fields and o.brand_id and o.brand_id.external_report_layout_id"
               t-call="{{o.brand_id.external_report_layout_id.sudo().key}}">
                <t t-set="brand_id" t-value="o.brand_id.id"/>
                <t t-set="company" t-value="o.brand_id.sudo()"/>
                <t t-out="0"/>
            </t>
            <!-- Preserve the native company layout for non-branded reports. -->
            <t t-elif="company.external_report_layout_id"
               t-call="{{company.external_report_layout_id.sudo().key}}">
                <t t-out="0"/>
            </t>
        </xpath>
    </template>
    <template id="styles_brand_report">
        <t t-foreach="brand_ids" t-as="brand" t-translation="off">
            <t t-set="font" t-value="brand.font or 'Lato'" />
            <t t-set="primary" t-value="brand.primary_color or 'black'" />
            <t t-set="secondary" t-value="brand.secondary_color or 'black'" />
            <t
            t-set="layout"
            t-value="brand.external_report_layout_id.key or 'web.external_layout_standard'"
        />
                // Simplified color-contrast function to replicate bootstrap in report preview.
                @function preview-color-contrast($background) {
                    @if (lightness($background) &gt; 50) {
                        @return black;
                    } @else {
                        @return white;
                    }
                }

            .o_brand_<t t-out='brand.id' />_layout {
                font-family:<t t-out="font" />;
                    h2 {
                        color: <t t-out="primary" />;
                    }

                    #informations strong {
                        color: <t t-out="secondary" />;
                    }

                    .o_total strong {
                        color: <t t-out="primary" />;
                    }

                    .o_company_tagline {
                        color: <t t-out="primary" />
                    }

            <t t-if="brand.report_tables_id == 'boxed'">
                &amp;.o_report_layout_boxed {
                    #total .o_total td {
                        background-color: <t t-out="primary" />;

                        strong {
                            color: preview-color-contrast(<t t-out="primary" />);
                        }
                    }
                }
            </t>
            <t t-elif="brand.report_tables_id == 'bold'">
                &amp;.o_report_layout_bold {
                    .o_main_table {
                        thead th {
                            border-top: 3px solid <t t-out="secondary" />;
                        }

                        tbody tr:last-child td {
                            border-bottom: 3px solid <t t-out="secondary" />;
                        }
                    }
                }
            </t>
            <t t-elif="layout == 'web.external_layout_folder'">
                &amp; .o_folder_header_container {
                    rect, path {
                        fill: mix(white, <t t-out="primary" />, 92%);
                    }
                }

                &amp;.o_report_layout_folder_footer {
                    border-top: 1px solid <t t-out="secondary" />;
                }
            </t>
            <t t-elif="layout == 'web.external_layout_wave'">
                &amp;.o_report_layout_wave {
                    #informations {
                        border-color: <t t-out="secondary" />;
                        background-color: mix(white, <t t-out="secondary" />, 92%);
                    }
                }
            </t>
            <t t-elif="brand.report_tables_id == 'bubble'">
                &amp;.o_report_layout_bubble {
                    #informations {
                        border-color: <t t-out="secondary" />;
                        background-color: mix(white, <t t-out="secondary" />, 92%);
                    }

                    thead th, #total .o_total td {
                        background-color: <t t-out="primary" />;
                        color: preview-color-contrast(<t t-out="primary" />);

                        strong {
                            color: preview-color-contrast(<t t-out="primary" />);
                        }
                    }
                }
            </t>
            }
        </t>
    </template>

    <!-- Odoo 20 centralizes the article in web.external_layout_body. -->
    <template id="external_layout_body_brand" inherit_id="web.external_layout_body">
        <xpath expr="//div[contains(@t-attf-class, 'article')]" position="attributes">
            <attribute name="t-attf-class" add="o_brand_#{brand_id}_layout" separator=" "/>
        </xpath>
    </template>

