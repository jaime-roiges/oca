<odoo>
  <record id="purchase_order_dimpal_blanket_form" model="ir.ui.view">
    <field name="name">purchase.order.dimpal.blanket.form</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="dimpal_blanket_order_id" domain="[('order_type','=','blanket'), ('company_id','=',company_id)]"/>
      </xpath>
    </field>
  </record>
</odoo>
