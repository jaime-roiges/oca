<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_origin_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(construction_origin_report=True)"/>
                <t t-set="print_with_payments" t-value="False"/>
                <t t-set="proforma" t-value="False"/>
                <t t-set="lang" t-value="o.partner_id.lang or user.lang"/>
                <t t-call="account.report_invoice_document" t-lang="lang"/>
            </t>
        </t>
    </template>
    <template id="report_invoice_origin_breakdown" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='total']" position="before">
            <t t-if="o.env.context.get('construction_origin_report')">
                <t t-set="cert" t-value="env['construction.certification'].search([('invoice_id', '=', o.id)], limit=1)"/>
                <div t-if="cert" class="mb-3">
                    <strong>Origin Invoice</strong><br/>
                    <strong>Cumulative work certification</strong><br/>
                    <span t-field="cert.name"/> — <span t-field="cert.sale_order_id.name"/>
                    <table class="table table-sm">
                        <tr><td>Certified to Origin</td><td class="text-end"><span t-field="cert.amount_certified_origin"/></td></tr>
                        <tr><td>Previously Certified</td><td class="text-end"><span t-field="cert.amount_previously_invoiced"/></td></tr>
                        <tr><td>Amount This Period</td><td class="text-end"><span t-field="cert.amount_to_invoice"/></td></tr>
                        <tr t-if="cert.amount_retention"><td>Guarantee Retention</td><td class="text-end"><span t-field="cert.amount_retention"/></td></tr>
                        <tr t-if="cert.amount_advance_applied"><td>Advance Applied</td><td class="text-end"><span t-field="cert.amount_advance_applied"/></td></tr>
                    </table>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
