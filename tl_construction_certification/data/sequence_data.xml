<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_construction_certification" model="ir.sequence">
            <field name="name">Work Certification</field>
            <field name="code">construction.certification</field>
            <field name="prefix">CERT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_construction_advance" model="ir.sequence">
            <field name="name">Construction Advance</field>
            <field name="code">construction.advance</field>
            <field name="prefix">ANT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
