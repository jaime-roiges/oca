<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_construction_certification" model="ir.ui.view">
        <field name="name">res.company.form.construction.certification</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Construction" name="construction_certification">
                    <group>
                        <field name="construction_advance_account_id"/>
                        <field name="construction_retention_account_id"/>
                        <field name="construction_approval_policy"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
