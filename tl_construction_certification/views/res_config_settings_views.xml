<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_construction" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.construction</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Construction Accounting" name="construction_accounting" groups="account.group_account_manager">
                    <setting string="Construction Accounts" help="Configure accounts for advances and guarantee retentions for the current company." company_dependent="1">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="construction_advance_account_id" class="col-lg-4 o_light_label"/>
                                <field name="construction_advance_account_id" domain="[('account_type', '=', 'liability_current'), ('company_ids', 'in', company_id), ('reconcile', '=', True)]" options="{'no_create': True}"/>
                            </div>
                            <div class="row mt8">
                                <label for="construction_retention_account_id" class="col-lg-4 o_light_label"/>
                                <field name="construction_retention_account_id" domain="[('account_type', '=', 'asset_current'), ('company_ids', 'in', company_id), ('reconcile', '=', True)]" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
