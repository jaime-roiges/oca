<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_retention_open_list" model="ir.ui.view">
        <field name="name">construction.retention.open.list</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="Open Guarantee Retentions" create="0" edit="0" delete="0" default_order="date_maturity,date,id">
                <field name="date"/>
                <field name="date_maturity"/>
                <field name="partner_id"/>
                <field name="construction_certification_id"/>
                <field name="move_id"/>
                <field name="account_id"/>
                <field name="construction_adjustment_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="amount_residual"/>
            </list>
        </field>
    </record>
    <record id="action_construction_retention_open" model="ir.actions.act_window">
        <field name="name">Open Guarantee Retentions</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_construction_retention_open_list"/>
        <field name="domain">[('construction_adjustment_type', 'in', ['retention', 'retention_release']), ('parent_state', '=', 'posted'), ('reconciled', '=', False)]</field>
    </record>
    <menuitem id="menu_construction_retention_open" name="Open Guarantee Retentions"
              parent="menu_construction_certification_root"
              action="action_construction_retention_open"
              groups="account.group_account_user" sequence="30"/>
</odoo>
