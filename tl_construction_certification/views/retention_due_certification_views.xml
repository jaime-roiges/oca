<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="certification_form_retention_due" model="ir.ui.view">
        <field name="name">construction.certification.form.retention.due</field>
        <field name="model">construction.certification</field>
        <field name="inherit_id" ref="tl_construction_certification.view_construction_certification_form"/>
        <field name="arch" type="xml">
            <field name="retention_percent" position="after">
                <field name="retention_due_date" readonly="state == 'cancel'" invisible="is_retention_liquidation"/>
            </field>
        </field>
    </record>
    <record id="certification_list_retention_due" model="ir.ui.view">
        <field name="name">construction.certification.list.retention.due</field>
        <field name="model">construction.certification</field>
        <field name="inherit_id" ref="tl_construction_certification.view_construction_certification_list"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="retention_due_date" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
